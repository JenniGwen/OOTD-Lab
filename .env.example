GEMINI_API_KEY=
APP_URL="MY_APP_URL"
# Self-hosted try-on (python -m uvicorn server:app --port 8000). Leave empty to use Gemini.
VTON_BACKEND_URL=http://localhost:8000
# Hybrid try-on on Modal (modal_app/): URL printed by `modal deploy app.py`. Takes priority over VTON_BACKEND_URL.
MODAL_VTON_URL=
# Optional: comma-separated Chrome extension ids allowed to call /api/ext (empty = any).
EXTENSION_IDS=
# Chrome Web Store link of the extension. When set, the install page/banner show a one-click
# "Tambahkan ke Chrome" button instead of the manual ZIP install.
VITE_CHROME_WEBSTORE_URL=
